setwd("/media/beatus/Beatus_Lyimo/E_COLI_paper_raw_data/mlst_analysis")

BiocManager::install("igraph")
library(igraph)
library(ape)
library(ggplot2)
#####
# Load required libraries
library(igraph)
library(ape)
library(ggplot2)

# Load MLST results (ensure tab-separated file)
mlst_data <- read.table("mlst_results_all.txt", sep="\t", header=FALSE, stringsAsFactors=FALSE)

# Define column names
colnames(mlst_data) <- c("Sample_id", "Species", "ST", "dinB", "icdA", "pabB", "polB", "putP", "trpA", "trpB", "udiA", " source")

# Extract allele profiles (excluding Isolate, Species, ST, and Source)
allele_profiles <- mlst_data[, 4:9]

#allele_profiles <- as.data.frame(lapply(allele_profiles, as.numeric))

# Compute Hamming distance function
hamming_distance <- function(x, y) sum(x != y)

# Generate a pairwise distance matrix
distance_matrix <- as.matrix(dist(allele_profiles, method="manhattan")) # Manhattan ~ Hamming distance
sum(is.na(distance_matrix))  # Count NA values
sum(is.nan(distance_matrix)) # Count NaN values


distance_matrix <- na.omit(distance_matrix)

# Convert to a graph
g <- graph_from_adjacency_matrix(distance_matrix, mode="undirected", weighted=TRUE)

# Compute Minimum Spanning Tree (MST)
mst <- mst(g)

# Assign colors to each isolate based on source
source_colors <- rainbow(length(unique(mlst_data$Source)))
names(source_colors) <- unique(mlst_data$Source)

node_colors <- source_colors[mlst_data$Source]

# Plot MST
plot(mst, 
     vertex.label=mlst_data$Isolate, 
     vertex.color=node_colors, 
     edge.width=E(mst)$weight / max(E(mst)$weight) * 5, # Scale edge width
     main="Minimum Spanning Tree of MLST Data")

# Add legend
legend("topright", legend=names(source_colors), fill=source_colors, title="Isolate Source")




