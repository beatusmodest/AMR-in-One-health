library(igraph)
library(tidyverse)
library(ggraph)
install.packages("ggraph")
#############################

# Load required libraries
library(igraph)
library(tidyverse)
library(ggraph)

# Step 1: Load your dataset
merged_df_all_plasmid <- read.csv("merged_df_all_plasmid.csv", stringsAsFactors = FALSE)

# Step 2: Filter dataset to include only the four relevant sources
valid_sources <- c("livestock", "human", "environment", "Nile_perch")

filtered_df <- merged_df_all_plasmid %>%
  filter(source %in% valid_sources)

# Step 3: Identify plasmids shared across multiple sources
shared_plasmids <- filtered_df %>%
  group_by(plasmid_name) %>%
  filter(n_distinct(source) > 1) %>%
  ungroup()

# Step 4: Create nodes (unique plasmid + source combinations)
nodes <- shared_plasmids %>%
  mutate(node_id = paste(plasmid_name, source, sep = "_")) %>%
  select(node_id, plasmid_name, source) %>%
  distinct()

# Step 5: Create edges between plasmids that share sources
edges <- shared_plasmids %>%
  group_by(plasmid_name) %>%
  summarise(pairs = list(combn(unique(source), 2, simplify = FALSE)), .groups = "drop") %>%
  unnest(cols = c(pairs)) %>%
  mutate(from_source = map_chr(pairs, 1), 
         to_source = map_chr(pairs, 2)) %>%
  mutate(from = paste(plasmid_name, from_source, sep = "_"),
         to = paste(plasmid_name, to_source, sep = "_")) %>%
  select(from, to) %>%
  distinct()

# Step 6: Ensure edges align with valid nodes
edges <- edges %>%
  filter(from %in% nodes$node_id & to %in% nodes$node_id)

# Step 7: Build the plasmid-sharing network
plasmid_network <- graph_from_data_frame(edges, vertices = nodes, directed = FALSE)

# Step 8: Assign attributes (e.g., source) to graph vertices
V(plasmid_network)$source <- nodes$source[match(V(plasmid_network)$name, nodes$node_id)]
V(plasmid_network)$plasmid_name <- nodes$plasmid_name[match(V(plasmid_network)$name, nodes$node_id)]

# Step 9: Set One Health source colors
source_colors <- c("livestock" = "#1f78b4",   # Blue
                   "human" = "#33a02c",       # Green
                   "environment" = "#ff7f00", # Orange
                   "nile_perch" = "#e31a1c")  # Red

V(plasmid_network)$color <- source_colors[V(plasmid_network)$source]

# Step 10: Visualize the plasmid-sharing network
ggraph(plasmid_network, layout = "fr") +
  geom_edge_link(aes(width = 0.8), color = "gray80", alpha = 0.7) +
  geom_node_point(aes(color = source), size = 5) +
  geom_node_text(aes(label = plasmid_name), repel = TRUE, size = 3) +
  scale_color_manual(values = source_colors) +
  theme_void() +
  labs(title = "Plasmid Sharing Network Across One Health Sources",
       subtitle = "Nodes represent plasmids within a source, edges indicate shared plasmids",
       color = "Source") +
  theme(legend.position = "right")



