# Check if parentheses are balanced in the Newick string
check_parentheses <- function(newick) {
  open_count <- sum(grepl("\\(", newick))
  close_count <- sum(grepl("\\)", newick))
  return(open_count == close_count)
}

if (check_parentheses(final_newick_string_clean)) {
  cat("Parentheses are balanced.\n")
