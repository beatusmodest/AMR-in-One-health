ggplot(summary, aes(x = source, y = Class, fill = Count)) +
  geom_tile() +
  facet_wrap(~ Subclass) +
  scale_fill_gradient(low = "white", high = "blue") +
  theme_minimal() +
  labs(title = "Distribution of Antibiotic Classes and Subclasses by Source",
       x = "Source",
       y = "Antibiotic Class",
       fill = "Count")


amr_data <- read.delim("amr_results.txt", header = TRUE, sep = "\t")

# View first few rows of the data
head(amr_data)
# If necessary, remove non-numeric columns (e.g., Gene column)
amr_matrix <- amr_data[, -1]  # Assuming first column is gene names

# Convert to matrix
amr_matrix <- as.matrix(amr_matrix)

sum(is.na(amr_matrix))

amr_matrix[is.na(amr_matrix)] <- 0

amr_matrix <- apply(amr_matrix, 2, function(x) ifelse(is.na(x), median(x, na.rm=TRUE), x))

amr_matrix <- amr_matrix[rowSums(is.na(amr_matrix)) < ncol(amr_matrix) * 0.5, ]

amr_matrix <- amr_matrix[, colSums(is.na(amr_matrix)) < nrow(amr_matrix) * 0.5]


library(pheatmap)
library(ggheatmap)

pheatmap(amr_matrix)

# Plot heatmap
pheatmap(amr_matrix, 
         cluster_rows = TRUE, 
         cluster_cols = TRUE, 
         show_rownames = TRUE, 
         show_colnames = TRUE, 
         main = "AMR Gene Heatmap of E. coli Isolates")



# Load the VCF file (Replace 'your_file.vcf' with actual file path)
vcf_file <- read.vcfR("merge_all.vcf.gz")
######
vcf <- read.vcfR("input.vcf")
gt <- extract.gt(vcf_file, return.alleles = FALSE)
missing <- apply(gt, 2, function(x) sum(is.na(x))/length(x))  # Calculate missing rate
barplot(missing, main="Missing Genotype Frequency", col="red")




# Convert VCF to a genetic distance matrix
genotype_matrix1 <- extract.gt(vcf_file, return.alleles = FALSE) # Extract genotype data

genotype_matrix <- na.omit(genotype_matrix1)  # Remove rows with NA


# Convert genotype matrix to a numeric format (e.g., 0, 1, 2 for homozygous/heterozygous)
genotype_matrix[genotype_matrix == "0/0"] <- 0
genotype_matrix[genotype_matrix == "0/1"] <- 1
genotype_matrix[genotype_matrix == "1/1"] <- 2
genotype_matrix <- apply(genotype_matrix, 2, as.numeric)  # Convert to numeric matrix

# Compute a distance matrix (Euclidean or other distance metrics)
distance_matrix <- dist(genotype_matrix, method = "euclidean") 

# Convert to matrix form
distance_matrix <- as.matrix(distance_matrix)

# Assign row and column names (Sample IDs)
rownames(distance_matrix) <- colnames(distance_matrix) <- colnames(genotype_matrix)


