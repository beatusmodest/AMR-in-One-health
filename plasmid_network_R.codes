source_colors <- c("nile_perch" = "lightblue", "livestock" = "lightgreen", "human" = "lightcoral", "environment" = "lightyellow")

# Assign colors to nodes based on their source
node_colors <- source_colors[V(graph)$source]

# Plot the network with coloring by source
plot(graph,
     vertex.size = 30,               # Node size
