# Load required libraries
library(ggtree)
library(ggplot2)
library(ape)
library(tidyverse)
library(igraph)
library(ggraph)

# Load required libraries
library(tidyverse)
library(igraph)
library(ggraph)

# Step 1: Clean the source names
amr_data_all2 <- amr_data_all2 %>%
  mutate(source = case_when(
    source == "Environment and Fish" ~ "environment",
    source == "Nile_perch" ~ "fish",
    TRUE ~ source
  ))


# Step 2: Create edges for ARG-Host relationships (handle single-source cases)
edges_arg <- amr_data_all2 %>%
  select(arg_name = CombinedElements, source) %>%
  separate_rows(arg_name, sep = ";") %>%  # Split multiple ARGs if separated by ";"
  distinct() %>%
  group_by(arg_name) %>%
  summarise(
    pairs = if (n_distinct(source) > 1) {
      list(combn(unique(source), 2, simplify = FALSE))
    } else {
      list(NULL)  # Handle ARGs present in only one source
    },
    .groups = "drop"
  ) %>%
  unnest(pairs) %>%
  filter(!is.null(pairs)) %>%  # Remove NULL pairs
  mutate(
    from_source = map_chr(pairs, 1),  # Extract the first element of each pair
    to_source = map_chr(pairs, 2)     # Extract the second element of each pair
  ) %>%
  mutate(
    from = paste(arg_name, from_source, sep = "_"),
    to = paste(arg_name, to_source, sep = "_")
  ) %>%
  select(from, to) %>%
  distinct()

# Check the output
head(edges_arg)

# Step 4: Create nodes for the ARGs and their sources (with source correction)
unique_names <- unique(c(edges_arg$from, edges_arg$to))

# Clean and standardize source names
clean_source <- sub(".*_", "", unique_names)
clean_source <- gsub("livectock_kenya", "livestock", clean_source)

# Create updated nodes dataframe
nodes_arg <- data.frame(
  name = unique_names,
  type = ifelse(grepl("human|livestock|fish|environment", unique_names), "Host", "ARG"),
  source = clean_source
)

# Step 5: Define custom colors for each source
source_colors <- c("livestock" = "lightblue", "human" = "lightgreen", "fish" = "lightcoral", "environment" = "lightyellow")


# Verify the fix
table(nodes_arg$source)  # Check for any remaining typos
head(nodes_arg)


# Step 6: Create the graph object
arg_network <- graph_from_data_frame(edges_arg, vertices = nodes_arg, directed = FALSE)

# Step 7: Visualize the ARG-Host Sharing Network
ggraph(arg_network, layout = "fr") +
  geom_edge_link(aes(width = 0.8), color = "gray80", alpha = 0.7) +
  geom_node_point(aes(color = source), size = 5) +
  geom_node_text(aes(label = name), repel = TRUE, size = 3) +
  scale_color_manual(values = source_colors) +
  theme_void() +
  labs(
    title = "ARG-Host Network Across One Health Sources",
    subtitle = "Nodes represent ARGs and host sources, edges indicate shared resistance genes",
    color = "Source"
  ) +
  theme(legend.position = "right")

