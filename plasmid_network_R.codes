amr_data_all <- read.csv("All_AMR_merged_amr_results_all.csv"), row.names = 1, check.names = FALSE)

# Separate the CombinedElements into individual ARGs
expanded_data <- amr_data_all %>%
  separate_rows(Elementsymbol, sep = ", ") %>%
  distinct()

# Create a list of unique ARGs for each host group
arg_list <- expanded_data %>%
  group_by(source) %>%
  summarise(ARGs = list(unique(Elementsymbol))) %>%
  deframe()

# Plot the Venn diagram
ggVennDiagram(arg_list) +
  scale_fill_gradient(low = "lightblue", high = "darkblue") +
  theme(legend.position = "none")


##### alternative
# Plot the Venn diagram with enhanced aesthetics
ggVennDiagram(arg_list, label_alpha = 0) +
  scale_fill_gradient(low = "lightblue", high = "darkblue") +  # Gradient fill for regions
  scale_color_manual(values = c("black", "black", "black")) +  # Edge colors
  theme_void() +  # Clean theme without axes
  theme(
    legend.position = "none",  # Remove legend
    plot.title = element_text(hjust = 0.5, size = 16, face = "bold"),  # Centered and bold title
    plot.margin = margin(10, 10, 10, 10)  # Adjust plot margins
  ) +
  labs(title = "Venn Diagram of ARGs Shared by Host Groups")  # Add a title


