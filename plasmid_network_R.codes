# Step 1: Clean and standardize the source names
amr_data_all2 <- amr_data_all2 %>%
  mutate(source = gsub("livectock_kenya", "livestock", source),
         source = gsub("Nile_perch", "fish", source),
         source = gsub("Environment and Fish", "environment", source))

# Step 2: Separate multiple ARGs if combined
amr_data_clean <- amr_data_all2 %>%
  select(arg_name = CombinedElements, source) %>%
  separate_rows(arg_name, sep = ";") %>%
  distinct()

# Step 3: Create a summary table showing ARGs and the sources where they appear
arg_sharing_table <- amr_data_clean %>%
  group_by(arg_name) %>%
  summarise(Sources = paste(unique(source), collapse = ", "), 
            Total_Sources = n_distinct(source)) %>%
  arrange(desc(Total_Sources))

# Step 4: Display the table
head(arg_sharing_table, 20)  # Show the top 20 shared ARGs



