# Load the igraph library
library(igraph)

# Input files
input_data_kenya <- read.csv("plasmid_positions_kenya.csv", stringsAsFactors = FALSE)
input_data_nile_perch <- read.csv("plasmid_info_nile_perch.csv")
input_data_human <- read.csv("plasmid_info_human.csv")
input_data_livestock_tz <- read.csv("plasmid_info_livestock.csv")
input_data_fish_envo <- read.csv("plasmid_info_fish_envi.csv")

###### merge the 4 files
merged_df_all_plasmid <- rbind(input_data_nile_perch, input_data_human, input_data_livestock_tz,input_data_fish_envo )
# Open the file for appending
node_file_conn <- file(node_file, open = "a")
edge_file_conn <- file(edge_file, open = "a")

# Process each plasmid and create nodes and edges
for (i in 1:nrow(merged_df_all_plasmid)) {
  plasmid_name <- merged_df_all_plasmid$plasmid_name[i]
  source <- merged_df_all_plasmid$source[i]
  
  # Print plasmid details
  message("Plasmid: ", plasmid_name, ", Source: ", source)
  
  # Add node (plasmid) with source
  writeLines(paste(plasmid_name, source, sep = ","), node_file_conn)
  
  # Create edges between plasmids with matching names, irrespective of source
  shared_plasmids <- merged_df_all_plasmid[merged_df_all_plasmid$plasmid_name == plasmid_name, ]
  
  for (j in 1:nrow(shared_plasmids)) {
    other_plasmid <- shared_plasmids$plasmid_name[j]
    other_source <- shared_plasmids$source[j]
    
    # Ensure no self-edges
    if (plasmid_name != other_plasmid || source != other_source) {
      writeLines(paste(plasmid_name, other_plasmid, source, other_source, sep = ","), edge_file_conn)
    }
  }
}

# Close the file connections
close(node_file_conn)
close(edge_file_conn)

# Remove duplicate edges
edge_lines <- readLines(edge_file)
unique_edges <- unique(edge_lines)
writeLines(unique_edges, edge_file)

# Read nodes and edges data
nodes <- read.csv(node_file, header = FALSE, stringsAsFactors = FALSE)
edges <- read.csv(edge_file, header = FALSE, stringsAsFactors = FALSE)

# Create a graph from the edges
graph <- graph_from_edgelist(as.matrix(edges[, c(1, 2)]), directed = FALSE)

head(nodes)
head(edges)

nodes$V1 <- trimws(tolower(nodes$V1))  # Convert to lowercase and remove extra spaces
edges$V1 <- trimws(tolower(edges$V1))  # Same for the first column of edges
edges$V2 <- trimws(tolower(edges$V2))
graph <- graph_from_edgelist(as.matrix(edges[, c(1, 2)]), directed = FALSE)

vertex_names <- V(graph)$name
node_names <- nodes$V1
#########
if (all(node_names %in% vertex_names)) {
  message("Plasmid names match graph vertices!")
  # Assign the source to each vertex based on cleaned node names
  V(graph)$source <- nodes$V2
} else {
  message("Plasmid names still do not match graph vertices.")
  # Identify mismatched plasmid names
  mismatched <- setdiff(node_names, vertex_names)
  print(mismatched)
}


# Define colors for each source type
source_colors <- c("nile_perch" = "lightblue", "livestock" = "lightgreen", "human" = "lightcoral", "environment" = "lightyellow")

# Assign colors to nodes based on their source
node_colors <- source_colors[V(graph)$source]

# Plot the network with coloring by source
plot(graph,
     vertex.size = 30,               # Node size
     vertex.label.cex = 0.8,         # Label size
     vertex.label.color = "black",   # Label color
     vertex.color = node_colors,     # Node color based on source
     edge.color = "gray",            # Edge color
     edge.width = 1,                 # Edge width
     main = "Plasmid Network Plot by Source")   # Title


