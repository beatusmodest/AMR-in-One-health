newick_nile_perch <- create_newick_stepwise(arg_hierarchy[["Nile_perch"]])
newick_livestock_kenya <- create_newick_stepwise(arg_hierarchy[["Livestock_Kenya"]])
newick_livestock <- create_newick_stepwise(arg_hierarchy[["Livestock"]])

