create_newick_stepwise <- function(data) {
  # Start with an empty string
  newick_string <- ""
  
  # Manually process each antibiotic class
  newick_string <- paste0(newick_string, "(")
  
  # Process each class and join its genes with a comma
  newick_string <- paste0(newick_string, 
                          "AMINOGLYCOSIDE: ", paste(data[["AMINOGLYCOSIDE"]], collapse = ","), ",")
  newick_string <- paste0(newick_string, 
                          "BETA-LACTAM: ", paste(data[["BETA-LACTAM"]], collapse = ","), ",")
  newick_string <- paste0(newick_string, 
                          "QUINOLONE: ", paste(data[["QUINOLONE"]], collapse = ","), ",")
  newick_string <- paste0(newick_string, 
                          "STREPTOTHRICIN: ", paste(data[["STREPTOTHRICIN"]], collapse = ","), ",")
  newick_string <- paste0(newick_string, 
                          "SULFONAMIDE: ", paste(data[["SULFONAMIDE"]], collapse = ","), ",")
  newick_string <- paste0(newick_string, 
                          "TETRACYCLINE: ", paste(data[["TETRACYCLINE"]], collapse = ","))
  newick_string <- paste0(newick_string, ")")
  
  return(newick_string)
}

####
newick_env_fish <- create_newick_stepwise(arg_hierarchy[["Environment and Fish"]])

