#!/bin/bash

# Base directory to store all collected .gff files
BASE_COLLECT_DIR="./collected_gff"

# Step 1: Find and collect all .gff files from Prokka output directories
echo "Collecting .gff files into corresponding subdirectories..."
find . -type f -name "*.gff" | while read gff_file
do
    # Extract the sample name (parent directory name of the .gff file)
    sample_name=$(basename "$(dirname "$gff_file")")
    
    # Define the target subdirectory inside collected_gff
    target_dir="$BASE_COLLECT_DIR/$sample_name"
    mkdir -p "$target_dir"  # Create the subdirectory if it doesn't exist

    # Generate the target file name with the original .gff file name
    target_file="$target_dir/$(basename "$gff_file")"

    # Handle overwriting: Ensure unique file name
    if [[ -e "$target_file" ]]; then
        count=1
        while [[ -e "$target_dir/$(basename "${gff_file%.gff}")_$count.gff" ]]; do
            ((count++))
        done
        target_file="$target_dir/$(basename "${gff_file%.gff}")_$count.gff"
    fi

    # Copy the .gff file to the target subdirectory
    cp "$gff_file" "$target_file"
    echo "Collected: $target_file"
done



