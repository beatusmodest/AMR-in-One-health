create_newick <- function(data) {
  if (is.list(data)) {
    children <- sapply(names(data), function(name) paste0(create_newick(data[[name]]), name))
    return(paste0("(", paste(children, collapse = ","), ")"))
  } else {
    return(paste(data, collapse = ","))
  }
}

