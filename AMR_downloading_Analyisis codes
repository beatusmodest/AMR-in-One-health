#!/bin/bash

# Directory containing FASTQ files
FASTQ_DIR="./fastq_files"
# Directory to store FastQC output
OUTPUT_DIR="./fastqc_output"
mkdir -p "$OUTPUT_DIR"

# Run FastQC on all FASTQ files in the directory
for FASTQ_FILE in "$FASTQ_DIR"/*.fastq; do
    echo "Running FastQC on $FASTQ_FILE..."
    fastqc -o "$OUTPUT_DIR" "$FASTQ_FILE"
    if [ $? -eq 0 ]; then
        echo "FastQC completed for $FASTQ_FILE."
    else
        echo "Error running FastQC on $FASTQ_FILE."
    fi
done

echo "All FastQC analyses are complete. Results are in $OUTPUT_DIR."

