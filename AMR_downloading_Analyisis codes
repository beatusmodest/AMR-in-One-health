    echo "$(date +%Y%m%d%H%M%S)_$RANDOM"
}

# Step: Collect .fna files into one directory
echo "Collecting .fna files into $COLLECT_DIR..."
find . -type f -name "*.fna" | while read fna_file; do
    # Extract folder name as sample ID
    sample_name=$(basename "$(dirname "$fna_file")")
    
    # Generate a unique ID to ensure unique filenames
    unique_id=$(generate_unique_id)
    
    # Target file path with sample name and unique ID
    target_file="$COLLECT_DIR/${sample_name}_${unique_id}.fna"
    
    # Copy file to the collection directory
    cp "$fna_file" "$target_file"
    
    echo "Collected: $target_file"
