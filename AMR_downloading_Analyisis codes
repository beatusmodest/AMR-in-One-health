#!/bin/bash

# Loop through all paired-end FASTQ files in the directory
for read1 in *_1.fastq.gz
do
    # Get the sample name by removing the "_1.fastq.gz" suffix
    sample="${read1%_1.fastq.gz}"
    
    # Define the corresponding paired-end read2 file
    read2="${sample}_2.fastq.gz"
    
    # Check if the second read file exists
    if [[ -f "$read2" ]]; then
        echo "Running SPAdes for sample: $sample"
        
        # Create an output directory for this sample
        output_dir="${sample}_spades"
        
        # Run SPAdes
        spades.py -1 "$read1" -2 "$read2" -o "$output_dir" -t 6 -m 8
        
        echo "SPAdes completed for sample: $sample"
    else
        echo "Paired read file for $sample not found, skipping..."
    fi
done

