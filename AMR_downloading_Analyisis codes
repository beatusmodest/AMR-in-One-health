#!/bin/bash

# Directories
FASTQ_DIR="."          # Directory containing ERR*.fastq files
FASTQC_OUTPUT_DIR="./fastqc_output" # Directory to store FastQC results
MULTIQC_OUTPUT_DIR="./multiqc_output" # Directory to store MultiQC results

# Create output directories if they do not exist
mkdir -p "$FASTQC_OUTPUT_DIR"
mkdir -p "$MULTIQC_OUTPUT_DIR"

# Step 1: Run FastQC for all ERR*.fastq files
echo "Running FastQC for all ERR files..."
for FILE in "$FASTQ_DIR"/ERR*.fastq; do
    if [ -f "$FILE" ]; then
        echo "Processing $FILE..."
        fastqc -o "$FASTQC_OUTPUT_DIR" "$FILE"
    else
        echo "No ERR*.fastq files found in $FASTQ_DIR."
        exit 1
    fi
done
echo "FastQC analysis complete."

# Step 2: Unzip FastQC output files
echo "Unzipping FastQC output files..."
for ZIP_FILE in "$FASTQC_OUTPUT_DIR"/*.zip; do
    if [ -f "$ZIP_FILE" ]; then
        echo "Unzipping $ZIP_FILE..."
        unzip -o "$ZIP_FILE" -d "$FASTQC_OUTPUT_DIR"
    else
        echo "No FastQC zip files found in $FASTQC_OUTPUT_DIR."
        exit 1
    fi
done
echo "Unzipping complete."

# Step 3: Run MultiQC to summarize FastQC results
echo "Running MultiQC..."
multiqc "$FASTQC_OUTPUT_DIR" -o "$MULTIQC_OUTPUT_DIR"
if [ $? -eq 0 ]; then
    echo "MultiQC analysis complete. Results saved in $MULTIQC_OUTPUT_DIR."
else
    echo "MultiQC analysis failed. Please check the logs."
fi


















