#!/bin/bash

# Directory containing the VCF files
VCF_DIR="./"  # Current directory

# Output file for the merged VCF
MERGED_VCF="merged.vcf.gz"

# Temporary file to hold the list of sorted VCF files
SORTED_LIST="sorted_vcf_files.txt"

# Step 1: Sort and index all VCF files
echo "Sorting and indexing VCF files..."
> "$SORTED_LIST"  # Clear the list file
for vcf_file in "$VCF_DIR"/*.vcf.gz
do
    # Extract the base filename without the extension
    base_name=$(basename "$vcf_file" .vcf.gz)
    
    # Define sorted output file name
    sorted_vcf="${base_name}_sorted.vcf.gz"
    
    # Sort the VCF file
    echo "Sorting $vcf_file..."
    bcftools sort -Oz -o "$VCF_DIR/$sorted_vcf" "$vcf_file"
    
    # Index the sorted VCF file
    echo "Indexing $sorted_vcf..."
    bcftools index "$VCF_DIR/$sorted_vcf"
    
    # Add sorted VCF to the list
    echo "$VCF_DIR/$sorted_vcf" >> "$SORTED_LIST"
done

# Step 2: Merge all sorted VCF files
echo "Merging sorted VCF files..."
bcftools merge -l "$SORTED_LIST" -Oz -o "$VCF_DIR/$MERGED_VCF"

# Step 3: Index the merged VCF file
echo "Indexing the merged VCF file..."
bcftools index "$VCF_DIR/$MERGED_VCF"

# Cleanup temporary file
rm -f "$SORTED_LIST"

echo "VCF files have been successfully merged into $MERGED_VCF and indexed."




