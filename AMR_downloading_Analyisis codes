    # Step 1: Align reads to reference genome
    bwa mem -t $THREADS $REFERENCE ${SAMPLE}_1.fastq.gz ${SAMPLE}_2.fastq.gz > ${SAMPLE}.sam

    # Step 2: Convert SAM to sorted BAM
    samtools view -bS ${SAMPLE}.sam | samtools sort -o ${SAMPLE}_sorted.bam
    rm ${SAMPLE}.sam  # Remove large intermediate SAM file

    # Step 3: Index BAM
    samtools index ${SAMPLE}_sorted.bam

    # Step 4: Variant calling using bcftools
    bcftools mpileup -f $REFERENCE ${SAMPLE}_sorted.bam | bcftools call -mv -Ov -o ${OUTPUT_DIR}/${SAMPLE}.vcf

    # Optional: Filter variants
    bcftools filter -i 'QUAL>30 & DP>10' -o ${OUTPUT_DIR}/${SAMPLE}_filtered.vcf ${OUTPUT_DIR}/${SAMPLE}.vcf

    echo "Variant calling completed for $SAMPLE"
done

