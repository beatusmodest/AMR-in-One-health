import pandas as pd
import numpy as np
import networkx as nx
import matplotlib.pyplot as plt
from scipy.spatial.distance import pdist, squareform

# Load MLST results
df = pd.read_csv("mlst_results.txt", sep="\t", header=0)  # Ensure header row is used

# Convert column names to lowercase for consistency
df.columns = [col.lower() for col in df.columns]

# Extract MLST allele profiles (excluding non-genetic columns)
allele_profiles = df.iloc[:, 3:].astype(str)  # Ensure all values are treated as strings

# Compute pairwise Hamming distances
def hamming_distance(seq1, seq2):
    return sum(a != b for a, b in zip(seq1, seq2))

dist_matrix = squareform(pdist(allele_profiles.values, metric=lambda u, v: hamming_distance(u, v)))

# Create graph and add edges
G = nx.Graph()
num_nodes = len(df)

for i in range(num_nodes):
    for j in range(i + 1, num_nodes):
        G.add_edge(df.iloc[i, 0], df.iloc[j, 0], weight=dist_matrix[i, j])

# Compute Minimum Spanning Tree (MST)
mst = nx.minimum_spanning_tree(G)

# Define color mapping for sources
if "source" in df.columns:
    source_col = "source"
    source_categories = df[source_col].unique()
    colors = ["red", "blue", "green", "orange", "purple", "brown", "pink"]  # Extend if needed
    color_map = {source: colors[i % len(colors)] for i, source in enumerate(source_categories)}

    # Assign colors to nodes based on Source
    node_colors = [color_map.get(df[df["isolate"] == node][source_col].values[0], "gray") for node in mst.nodes]
else:
    node_colors = "gray"  # Default color if 'source' column is missing

# Plot MST
plt.figure(figsize=(14, 10))
pos = nx.spring_layout(mst, seed=42)  # Improve visualization
nx.draw(mst, pos, with_labels=True, node_color=node_colors, edge_color='gray', font_size=8, node_size=700)

# Add edge weights as labels
edge_labels = {(u, v): f"{d['weight']:.0f}" for u, v, d in mst.edges(data=True)}
nx.draw_networkx_edge_labels(mst, pos, edge_labels=edge_labels, font_size=6)

# Create a legend if 'source' column exists
if "source" in df.columns:
    legend_labels = [plt.Line2D([0], [0], marker='o', color='w', markerfacecolor=color, markersize=10) 
                     for source, color in color_map.items()]
    plt.legend(legend_labels, source_categories, title="Isolate Source", loc="upper right")

plt.title("Minimum Spanning Tree of MLST Data (Colored by Source)")
plt.show()



