#!/bin/bash

# Set reference genome and output directories
REFERENCE="/media/beatus/Beatus_Lyimo/E_COLI_paper_raw_data/reference_genom_2/U00096.3.fasta"
ALIGN_DIR="./alignments"
VCF_DIR="./bcftools_results"
mkdir -p "$ALIGN_DIR" "$VCF_DIR"

# Function to extract unique sample ID
extract_sample_id() {
    local filepath="$1"
    echo "$(basename "$filepath" .fna)"
}

# Check required tools
echo "Checking tools..."
if ! command -v bwa &> /dev/null; then echo "Error: bwa is not installed."; exit 1; fi
if ! command -v samtools &> /dev/null; then echo "Error: samtools is not installed."; exit 1; fi
if ! command -v bcftools &> /dev/null; then echo "Error: bcftools is not installed."; exit 1; fi

# Check BCFtools version
echo "Using BCFtools version: $(bcftools --version | head -n 1)"

# Process all .fna files
echo "Starting alignment and SNP calling..."
find . -type f -name "*.fna" | while read fna_file; do
    # Extract sample ID
    sample_id=$(extract_sample_id "$fna_file")

    # Define file paths
    bam_file="$ALIGN_DIR/${sample_id}.sorted.bam"
    vcf_gz_file="$VCF_DIR/${sample_id}.vcf.gz"

    # Step 1: Align .fna file to reference genome
    echo "Aligning $fna_file to $REFERENCE..."
    bwa mem "$REFERENCE" "$fna_file" | \
    samtools view -b - | \
    samtools sort -o "$bam_file"
    samtools index "$bam_file"

    # Step 2: Call SNPs using bcftools
    echo "Calling SNPs for $sample_id..."
    bcftools mpileup -f "$REFERENCE" "$bam_file" | \
    bcftools call -mv -Oz -o "$vcf_gz_file"
    bcftools index "$vcf_gz_file"

    # Confirm completion
    echo "Completed SNP calling for $sample_id. Results: $vcf_gz_file"
done

# Completion message
echo "SNP calling completed for all .fna files. Results saved in $VCF_DIR."

