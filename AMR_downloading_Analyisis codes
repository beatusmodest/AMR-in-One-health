import pandas as pd
import networkx as nx
import matplotlib.pyplot as plt
import matplotlib.cm as cm
from matplotlib.colors import Normalize

# Load the CSV file
file_path = '/media/beatus/Beatus_Lyimo/E_COLI_paper_raw_data/plasmid_analysis/plasmid_positions.csv'
df = pd.read_csv(file_path)

# Initialize a graph
G = nx.Graph()

# Collect all unique sources
sources = df['source'].unique()

# Add nodes and edges with source tracking
for source in sources:
    plasmids_in_source = df[df['source'] == source]['plasmid_name'].unique()

    for plasmid in plasmids_in_source:
        if not G.has_node(plasmid):
            G.add_node(plasmid, sources=set())
        G.nodes[plasmid]['sources'].add(source)

    for i in range(len(plasmids_in_source)):
        for j in range(i + 1, len(plasmids_in_source)):
            if not G.has_edge(plasmids_in_source[i], plasmids_in_source[j]):
                G.add_edge(plasmids_in_source[i], plasmids_in_source[j], source=set())
            G.edges[plasmids_in_source[i], plasmids_in_source[j]]['source'].add(source)

# Map node colors by the number of unique sources
node_colors = [len(data['sources']) for _, data in G.nodes(data=True)]

# Set up the color map
cmap = cm.get_cmap("plasma")
norm = Normalize(vmin=min(node_colors), vmax=max(node_colors))

# Draw the network
plt.figure(figsize=(12, 12))
pos = nx.spring_layout(G, seed=42)
nx.draw(G, pos, with_labels=True, node_size=700, node_color=node_colors, cmap=cmap, edge_color='gray')

# Add colorbar
sm = plt.cm.ScalarMappable(cmap=cmap, norm=norm)
sm.set_array([])
cbar = plt.colorbar(sm, ax=plt.gca(), orientation='vertical')
cbar.set_label('Number of Sources')

plt.title('Plasmid Co-occurrence Network Colored by Source Count')
plt.show()


