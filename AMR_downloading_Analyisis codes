#!/bin/bash

# Loop through all contigs.fasta files in the current directory and subdirectories
find . -type f -name "contigs.fasta" | while read contig_fasta
do
    # Get the directory where the contigs.fasta file is located
    parent_dir=$(dirname "$contig_fasta")
    
    # Create a subfolder named "prokka_output" inside the directory
    output_dir="$parent_dir/prokka_output"
    mkdir -p "$output_dir"  # Create the output directory if it doesn't already exist
    
    # Define the sample name for annotation prefix
    sample=$(basename "${contig_fasta}" .fasta)
    
    # Run Prokka and save the output in the subfolder
    prokka --outdir "$output_dir" --prefix "$sample" "$contig_fasta"
    
    echo "Prokka completed for sample: $sample, output saved in $output_dir"
done

